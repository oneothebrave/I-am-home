# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'DaojiaShuoYisheng' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # fmt 11.0.2 enables a consteval path that Apple Clang 21 rejects.
    # Apply the upstream-compatible one-line guard until React Native updates fmt.
    fmt_base_header = File.join(installer.sandbox.root.to_s, 'fmt/include/fmt/base.h')
    apple_clang_guard = '#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L'
    compatible_guard = '#elif defined(__apple_build_version__)'
    fmt_source = File.read(fmt_base_header)
    if fmt_source.include?(apple_clang_guard)
      File.chmod(0o644, fmt_base_header)
      File.write(fmt_base_header, fmt_source.sub(apple_clang_guard, compatible_guard))
    elsif !fmt_source.include?(compatible_guard)
      raise "Unable to apply the Apple Clang 21 fmt compatibility patch"
    end

    # Xcode 27 no longer accepts simulator deployment targets below iOS 15.
    # Keep third-party resource bundles aligned with React Native's minimum.
    installer.pods_project.targets.each do |pod_target|
      pod_target.build_configurations.each do |build_configuration|
        deployment_target = build_configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if !deployment_target.nil? && Gem::Version.new(deployment_target) < Gem::Version.new(min_ios_version_supported)
          build_configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end
    end
  end
end
